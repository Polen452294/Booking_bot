APP_ENV=development
BOOKING_IMAGE=booking-bot:local-build
# For a development build, set APP_VERSION from booking_bot.version.__version__.
# Production uses bookingctl and a published full-version image/digest; see docs/new-client.md.
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=anna-tattoo-bot
API_PORT=8000
POSTGRES_PORT=55432
REDIS_PORT=6379
# Development credentials only. Production must use independent random passwords.
POSTGRES_DB=booking
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
REDIS_PASSWORD=
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:55432/booking
REDIS_URL=redis://localhost:6379/0
# Optional override; otherwise Compose builds the URL from POSTGRES_*.
DOCKER_DATABASE_URL=
DOCKER_REDIS_URL=redis://redis:6379/0
SPECIALIST_CONFIG_PATH=specialist.toml
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800

# Public HTTPS origin without a trailing slash, for example https://booking.example.com
TELEGRAM_WEBHOOK_BASE_URL=

# Booking defaults
BOOKING_HORIZON_DAYS=60
BOOKING_MIN_LEAD_HOURS=3
SLOT_HOLD_MINUTES=10
CANCELLATION_CUTOFF_HOURS=24
BOOKING_DATES_SHOWN=14
NOTIFICATION_POLL_INTERVAL_SECONDS=2
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5

# One deployment uses one BotFather token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PROXY_URL=
DOCKER_TELEGRAM_PROXY_URL=
TELEGRAM_WEBHOOK_HEADER_SECRET=

# HOST ONLY: put monitoring credentials in /etc/booking-monitor.env (0600).
# These optional variables are never forwarded to client containers.
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=
BOOKING_MONITOR_DISK_WARNING=80
BOOKING_MONITOR_DISK_ERROR=90
BOOKING_MONITOR_DISK_CRITICAL=95
BOOKING_MONITOR_BACKUP_WARNING_HOURS=24
BOOKING_MONITOR_BACKUP_ERROR_HOURS=48
BOOKING_MONITOR_CERTIFICATE_WARNING_DAYS=30
BOOKING_MONITOR_CERTIFICATE_ERROR_DAYS=7
BOOKING_MONITOR_FAILED_JOBS_ERROR=10
BOOKING_MONITOR_COOLDOWN_SECONDS=21600
BOOKING_BACKUP_SAFETY=3
